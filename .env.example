# =====================================================================
# 0. DEPLOYMENT SCRIPT VARIABLES (Used by deploy.sh & update.sh)
# =====================================================================
GCP_PROJECT="your-gcp-project-id"
REGION="europe-west3"
SERVICE_NAME="papermark"
CLOUD_SQL_INSTANCE="your-project:europe-west3:your-instance"
DB_USER="postgres"
DB_PASS="your-db-password"
ADMIN_EMAIL="your-dataroom-admin-email"

# ==========================================
# 1. CORE APPLICATION URLs (REQUIRED)
# ==========================================
# Replace with your actual deployment domain. No trailing slashes.
NEXT_PUBLIC_APP_URL="https://documents.yourcompany.com"
NEXTAUTH_URL="https://documents.yourcompany.com"
NEXT_PUBLIC_BASE_URL="https://documents.yourcompany.com"
NEXT_PUBLIC_MARKETING_URL="https://documents.yourcompany.com"
NEXT_PUBLIC_APP_BASE_HOST="documents.yourcompany.com"

# ==========================================
# 2. SECURITY & ENCRYPTION (REQUIRED)
# ==========================================
# Run 'openssl rand -base64 32' in terminal to generate these. Keep them safe.
NEXTAUTH_SECRET="your-32-char-random-string"
NEXT_PRIVATE_DOCUMENT_PASSWORD_KEY="your-32-char-random-string"
NEXT_PRIVATE_VERIFICATION_SECRET="your-32-char-random-string"

# ==========================================
# 3. DATABASE (REQUIRED - CLOUD RUN FORMAT)
# ==========================================
# Format for Cloud Run socket connections:
DATABASE_URL="postgresql://DB_USER:DB_PASSWORD@localhost/papermark?host=/cloudsql/GCP_PROJECT_ID:GCP_REGION:INSTANCE_NAME"

# ==========================================
# 4. STORAGE (REQUIRED - GCS S3 INTEROPERABILITY)
# ==========================================
NEXT_PUBLIC_UPLOAD_TRANSPORT="s3"
NEXT_PRIVATE_UPLOAD_BUCKET="your-gcs-bucket-name"
NEXT_PRIVATE_UPLOAD_DISTRIBUTION_HOST="your-gcs-bucket-name.storage.googleapis.com"
NEXT_PRIVATE_UPLOAD_ENDPOINT="https://storage.googleapis.com"
NEXT_PRIVATE_UPLOAD_REGION="auto"
NEXT_PRIVATE_UPLOAD_ACCESS_KEY_ID="GOOG..."
NEXT_PRIVATE_UPLOAD_SECRET_ACCESS_KEY="your-gcp-secret-key"

# ==========================================
# 5. EMAIL (REQUIRED)
# ==========================================
RESEND_API_KEY="re_..."

# ==========================================
# 6. ANALYTICS (REQUIRED)
# ==========================================
TINYBIRD_TOKEN="your-tinybird-admin-token"
NEXT_PUBLIC_TINYBIRD_TRACKER_URL="https://api.gcp-eu-west2.tinybird.co"

# ==========================================
# 7. QUEUES & RATE LIMITING (REQUIRED)
# ==========================================
# QStash (Primary Background Jobs Manager)
QSTASH_URL="https://qstash-eu-central-1.upstash.io"
QSTASH_TOKEN="your-qstash-token"
QSTASH_CURRENT_SIGNING_KEY="your-current-signing-key"
QSTASH_NEXT_SIGNING_KEY="your-next-signing-key"

# Redis Locker (For Tus.io Secure Uploads)
UPSTASH_REDIS_REST_LOCKER_URL="https://your-redis-endpoint.upstash.io"
UPSTASH_REDIS_REST_LOCKER_TOKEN="your-redis-token"

# =====================================================================
# --- OPTIONAL CONFIGURATIONS (LEAVE BLANK IF UNUSED) ---
# =====================================================================

# --- GOOGLE OAUTH (Optional Alternative to Magic Links) ---
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# --- HANKO PASSKEYS (Optional Alternative Authentication) ---
# HANKO_API_KEY=
# NEXT_PUBLIC_HANKO_TENANT_ID=

# --- TRIGGER.DEV (Optional Alternative Workflow Engine) ---
# TRIGGER_SECRET_KEY=
# TRIGGER_API_URL=https://api.trigger.dev

# --- INCOMING WEBHOOKS (Optional External Integrations) ---
# NEXT_PUBLIC_WEBHOOK_BASE_URL=
# NEXT_PUBLIC_WEBHOOK_BASE_HOST=

# =====================================================================
# --- VERCEL ONLY (DO NOT USE FOR GCP CLOUD RUN DEPLOYMENTS) ---
# =====================================================================
# POSTGRES_PRISMA_URL=
# POSTGRES_PRISMA_URL_NON_POOLING=
# BLOB_READ_WRITE_TOKEN=
# PROJECT_ID_VERCEL=
# TEAM_ID_VERCEL=
# AUTH_BEARER_TOKEN=